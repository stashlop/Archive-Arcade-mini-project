# Copy to .env for local development. Never commit real values.
# On Render, set these under the service's Environment tab (or an Environment Group).

# --- Required in production ------------------------------------------------
# Signs sessions and CSRF tokens. Must be the same for every worker/instance.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string (Neon, Render Postgres, ...). Leave unset locally to
# use SQLite at A&A/instance/arcade.db. Render's filesystem is ephemeral, so without
# this all accounts, orders and bookings are lost on every deploy.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for the seeded "admin" account, used only when that account is first
# created. If unset in production the admin gets an unguessable random password.
# (Local dev with FLASK_ENV=development or run_local.py falls back to admin123.)
ADMIN_DEFAULT_PASSWORD=choose-a-strong-password

# Extra usernames (comma separated) that get admin rights. "admin" always does.
ADMIN_USERS=admin

# --- Optional ----------------------------------------------------------------
# Cloudinary for uploads (profile photos, Constellation files). Without it uploads
# are written to A&A/static/uploads, which does not persist on Render.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# AI-assisted idea graphs in Constellation (OpenAI or OpenRouter key)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_IDEA_MODEL=openai/gpt-4o-mini

# MongoDB for Constellation chat (when set, chat/friends use MongoDB instead of SQL)
# MONGODB_URI=your_mongodb_connection_string_here
# MONGODB_DB=arcade

# Restrict cross-origin API access (default "*"; the site itself is same-origin)
# CORS_ORIGINS=https://your-site.onrender.com

# Cafe settings
# CAFE_OPEN=10:00
# CAFE_CLOSE=22:00
# CAFE_SLOT_STEP_MIN=60
# CAFE_DEFAULT_DURATION=60
# CAFE_SLOT_CAPACITY=10
# USD_TO_INR=83

# Local development only
# FLASK_ENV=development
# ENABLE_NETWORK_DIAGNOSTICS=1   # expose host/IP details at /api/network-status
